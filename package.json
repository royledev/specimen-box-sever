{
  "name": "specimen-box-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "標本箱アプリのバックエンド（問い配信＋ランダム標本画像配信）。Hono on Cloudflare Workers。",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy -c wrangler.prod.jsonc",
    "migrate:prod": "wrangler d1 migrations apply specimen-box-db --remote -c wrangler.prod.jsonc",
    "seed:prod:questions": "wrangler d1 execute specimen-box-db --remote --file=seeds/prod/questions.sql -c wrangler.prod.jsonc",
    "seed:prod:images": "wrangler d1 execute specimen-box-db --remote --file=seeds/prod/images.sql -c wrangler.prod.jsonc",
    "seed:prod": "npm run seed:prod:questions && npm run seed:prod:images",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:images": "node tools/gen-dummy-images.mjs && node tools/gen-seed.mjs",
    "seed:local": "bash scripts/seed-local.sh"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1",
    "wrangler": "^3.80.0"
  }
}
